# Copy to Secrets.env (gitignored) and fill in. A device build has no access to your shell
# environment or the repo's .env, so this file is copied into the app bundle at build time.
CMD_API_KEY=
FOOD_BASE_URL=https://api.commandcode.ai/provider/v1
FOOD_MODEL=xiaomi/mimo-v2.6-flash
FOOD_FALLBACK_MODELS=meta/muse-spark-1.3-contributor,Qwen/Qwen3.7-Flash,poolside/laguna-s-2.1-free

# Optional: OpenRouter embeddings for hybrid FoodKeeper matching. Leave blank for lexical-only.
OPENROUTER_API_KEY=
FOOD_EMBED_BASE_URL=https://openrouter.ai/api/v1
FOOD_EMBED_MODEL=baai/bge-base-en-v1.5

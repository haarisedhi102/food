# Command Code Provider API key (Studio -> API keys). Required for classification/chat.
CMD_API_KEY=
# Endpoint + models. MiMo V2.6 Flash won a head-to-head benchmark on this task.
FOOD_BASE_URL=https://api.commandcode.ai/provider/v1
FOOD_MODEL=xiaomi/mimo-v2.6-flash
FOOD_FALLBACK_MODELS=meta/muse-spark-1.3-contributor,Qwen/Qwen3.7-Flash,poolside/laguna-s-2.1-free
FOOD_CLASSIFY_WORKERS=6

# Optional. OpenRouter embeddings power hybrid (keyword + semantic) FoodKeeper search.
# The default model is free; leave the key blank to fall back to keyword-only matching.
OPENROUTER_API_KEY=
FOOD_EMBED_MODEL=nvidia/nemotron-3-embed-1b:free

FOOD_DB_PATH=data/food.db
FOOD_COSTCO_LOOKBACK_DAYS=90
FOOD_KROGER_LOOKBACK_DAYS=90
FOOD_CHAT_DAILY_BUDGET=30
FOOD_ARCHIVE_AFTER_DAYS=14
